{
  "name": "neon-terminal",
  "version": "1.1.5",
  "description": "Terminal futurista i personalitzable amb Claude Code integrat",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "pack": "electron-builder --win dir"
  },
  "author": "Kirito",
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.15",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0"
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3"
  },
  "productName": "Neon Terminal",
  "license": "MIT",
  "build": {
    "appId": "NeonTerminal.Hex.1",
    "productName": "Neon Terminal",
    "copyright": "Kirito",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "main-features.js",
      "irc.js",
      "diag.js",
      "preload.js",
      "src/**/*",
      "shell/**/*",
      "package.json",
      "!src/**/*.map"
    ],
    "asarUnpack": [
      "shell/**/*",
      "node_modules/@lydell/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src/icon-hex.ico",
      "executableName": "NeonTerminal"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Neon Terminal",
      "installerIcon": "src/icon-hex.ico",
      "uninstallerIcon": "src/icon-hex.ico",
      "installerHeaderIcon": "src/icon-hex.ico",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh",
      "artifactName": "NeonTerminal-Setup-${version}.exe"
    }
  }
}
